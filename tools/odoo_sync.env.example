# Load these in the service/process environment. Never commit real secrets.
ODOO_URL=https://wadnooh1.odoo.com
ODOO_DATABASE=
ODOO_LOGIN=
ODOO_API_KEY=
ODOO_COMPANY_ID=
ODOO_COMPANY_NAME=
