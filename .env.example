# انسخ هذا الملف إلى .env واملأ المتغيرات
# لا تقم أبداً بإضافة ملف .env إلى نظام التحكم بالمصادر (مثل Git)

# مفتاح سري عشوائي وطويل يستخدمه Flask لتأمين الجلسات (sessions)
# يمكنك توليد واحد باستخدام: python -c 'import secrets; print(secrets.token_hex())'
SECRET_KEY=

# إعدادات اختيارية لرفع النسخ الاحتياطية إلى AWS S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=

# متغيرات حماية المبرمج (إلزامية لتعديل الهيكل مثل التبويبات وبنود العقد)
# البريد المعتمد لإرسال رموز التحقق
PROGRAMMER_EMAILS=wadnooh@gmail.com,wadnooh@wadnooh.com
# رمز سري لمرة واحدة لتسجيل الجهاز الرئيسي للمبرمج
PROGRAMMER_BOOTSTRAP_CODE=
# رمز سري ثابت يُرسل مع رمز التحقق (OTP) لتأكيد التعديلات من جهاز غير رئيسي
PROGRAMMER_CHANGE_PIN=

# وضع التشغيل التجريبي (للاستضافة المجانية على Render)
# يؤثر على طريقة تخزين الصور (مؤقتة) وبعض الميزات
# TRIAL_MODE=1

# بريد SMTP (لرموز المبرمج وكود تأكيد الحذف)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# WhatsApp Cloud API (اختياري — كود تأكيد الحذف)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v20.0
